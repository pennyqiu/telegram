# 复制为同目录 qdii_email.env 后填写（该文件已 gitignore，勿提交）
# cp friends/tools/qdii_email.env.example friends/tools/qdii_email.env

EMAIL_ENABLED=false

# daily = 每次定时任务都发日报
# alert = 仅当出现「可买」(溢价<2%) 时发
# both  = 每天发日报；若有可买则在标题标注【可买机会】
EMAIL_MODE=daily

SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your@qq.com
SMTP_PASSWORD=your_smtp_auth_code
EMAIL_SENDER=your@qq.com

# 收件人优先读 git 文件 friends/tools/qdii_email_recipients.txt（一行一个）
# 仅当该文件为空时，才用下面的 EMAIL_RECIPIENTS 作备用
EMAIL_RECIPIENTS=

# 监控页链接（写进邮件正文）
MONITOR_URL=https://learn.tgfootclub.com/friends/qdii-monitor.html
