# 复制为同目录 qdii_email.env 后填写（该文件已 gitignore，勿提交）
# cp friends/tools/qdii_email.env.example friends/tools/qdii_email.env

EMAIL_ENABLED=false

# 投递策略由 friends/tools/qdii_email_recipients.txt 的类型标签控制（不再用 EMAIL_MODE）：
#   all  = 每次定时任务都发（心跳日报；失败也会通知）→ 用来确认流程跑通
#   us   = 美股策略，仅买点触发时发
#   qdii = 国内策略，仅「可投」机会时发
# EMAIL_MODE 已废弃，保留下面一行仅为兼容旧配置，脚本会忽略。
EMAIL_MODE=ignored

SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your@qq.com
SMTP_PASSWORD=your_smtp_auth_code
EMAIL_SENDER=your@qq.com

# 收件人优先读 git 文件 friends/tools/qdii_email_recipients.txt（一行一个）
# 仅当该文件为空时，才用下面的 EMAIL_RECIPIENTS 作备用（视为 all/心跳收件人）
EMAIL_RECIPIENTS=

# 监控页链接（写进邮件正文）
MONITOR_URL=https://learn.tgfootclub.com/friends/qdii-monitor.html
