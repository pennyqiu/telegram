# 金渐成文章存档 - 私人存档不推送到公开仓库
jinjiancheng_archive/private/
jinjiancheng_archive/metadata.json

# 调试文件
page_debug.html
jinjiancheng_scraper.py

# 其他临时文件
*.pyc
__pycache__/
.DS_Store

# 环境变量 / 密钥（含 IB 密码、TOTP、SMTP 等，切勿提交）
.env
**/.env
!**/.env.example
friends/tools/qdii_email.env

# QDII 溢价监控：由服务器 cron 每日刷新，避免 git pull 覆盖
friends/qdii-premium.json
friends/qdii-history.json
friends/tools/qdii_fees_cache.json

# QDII 量化回测：cron 每周重跑，页面读不到时回退 qdii-quant.sample.json
friends/qdii-quant.json

# QDII 溢价曲线：cron 每日重算，HTML 把数据内联进去了（便于单文件转发），
# 所以两个产物都不入库，避免 git pull 冲突。新环境跑一次
# `python3 friends/tools/build_qdii_premium_curve.py` 即可生成。
friends/qdii-premium-curve.json
friends/qdii-premium-curve.html

# 美股回撤阶梯监控：由服务器 cron 每日刷新，避免 git pull 覆盖
friends/us-dip-signal.json
# 本轮已提醒到哪一档（cron 自动维护），删掉只会导致重发一次当前已触发的档位
friends/tools/.us_dip_state.json
# 待投资金台账：含真实金额，不入库；从 us_dip_cash.example.json 复制
friends/tools/us_dip_cash.json

# 回测脚本的本地数据缓存（可随时重新拉取）
friends/tools/.bt_cache/
friends/tools/.hist_cache/
friends/tools/backtest_data/

# 运行日志
*.log
**/logs/

# kol_radar 运行产物
kol_radar/output/
